# Fake = provedor simulado (não precisa de conta) | Stripe = Stripe em modo TESTE
PAYMENT_PROVIDER=Fake

# Dashboard Stripe (modo Test) > Developers > API keys > Secret key (sk_test_...)
STRIPE_SECRET_KEY=

# Rode "docker compose --profile stripe up -d" e veja nos logs do stripe-cli:
#   docker compose logs stripe-cli   →  "Your webhook signing secret is whsec_..."
STRIPE_WEBHOOK_SECRET=

# Chave do JWT (mín. 32 caracteres)
JWT_KEY=dev-only-change-me-buynest-super-secret-key-32+